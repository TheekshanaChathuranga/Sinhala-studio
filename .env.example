# Application Environment
APP_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/subtitles
DATABASE_URL=sqlite:///./storage/subtitles.db

# Storage Path
STORAGE_DIR=./storage

# Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_MEDIA_DURATION_MINUTES=180
TEMP_FILE_RETENTION_HOURS=24

# Speech Recognition (ASR) Engine
# faster_whisper or mock
ASR_PROVIDER=faster_whisper
# Model options: tiny (fastest), base, small (recommended balance), medium, large-v3
ASR_MODEL=tiny
# Device: cpu or cuda
ASR_DEVICE=cpu
# Compute Type: int8, float16, float32
ASR_COMPUTE_TYPE=int8

# Sinhala Translation Engine
# Providers: hybrid, llm, google, mymemory, heuristic, mock
TRANSLATION_PROVIDER=hybrid
# Optional API Key for LLM translation (OpenAI, Gemini, Groq, or OpenRouter)
TRANSLATION_API_KEY=
# Optional Base URL if using Groq, Ollama, or custom endpoint
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini

# FFmpeg Executable (Leave blank for automatic portable discovery via imageio-ffmpeg or system PATH)
FFMPEG_BINARY=
